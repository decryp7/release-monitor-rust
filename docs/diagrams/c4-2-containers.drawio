        <mxCell id="title" value="&lt;span style=&quot;font-size:24px;font-weight:600&quot;&gt;Spotter — containers&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#14171C,#ECEEF1);" vertex="1" parent="1"><mxGeometry x="48" y="40" width="1416" height="32" as="geometry"/></mxCell>
        <mxCell id="kind" value="&lt;span style=&quot;font-size:14px;font-weight:400&quot;&gt;C4 · Level 2 — Containers&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="72" width="1416" height="24" as="geometry"/></mxCell>
        <mxCell id="desc" value="&lt;span style=&quot;font-size:12px;font-weight:400&quot;&gt;One desktop process holds the shell, the engine and the libraries; the web view shows the UI; Chromium is the only child process.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="96" width="1416" height="20" as="geometry"/></mxCell>
        <mxCell id="g" value="&lt;span style=&quot;font-size:12px;font-weight:600&quot;&gt;Spotter app [Tauri 2 · one process, logged-on user]&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=10;strokeWidth=1;strokeColor=light-dark(#C4C7CD,#353A42);fillColor=light-dark(#F8F9FA,#121418);dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontColor=light-dark(#565E6B,#A0A7B2);" vertex="1" parent="1"><mxGeometry x="48" y="144" width="1056" height="480" as="geometry"/></mxCell>
        <mxCell id="ui" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Angular UI&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Angular 22 in the OS web view]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Main window and tray popup; talks only to the backend service.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#0072B2,#56B4E9);fillColor=light-dark(#E6F1F7,#1F303C);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="72" y="184" width="264" height="112" as="geometry"/></mxCell>
        <mxCell id="shell" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Tauri shell&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[app/src-tauri: Rust]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Async commands that validate every argument; tray, popup and lifecycle; ShellNotifier and the keyring SecretStore.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#0B7A6E,#2CC4B0);fillColor=light-dark(#E7F2F1,#193333);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="72" y="336" width="264" height="264" as="geometry"/></mxCell>
        <mxCell id="eng" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;spotter-engine&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Rust library]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;The Engine facade, scheduler, polite fetcher with the loopback guard, check pipeline, notification delivery and actions. Owns every watch and its state; writes the database and spotter.toml.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#0B7A6E,#2CC4B0);fillColor=light-dark(#E7F2F1,#193333);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="432" y="184" width="288" height="416" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;spotter-core&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Rust library, no I/O]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Versions, filters, soak, schedule, notification policy, packs, ports.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#4C5BD4,#8FA3FF);fillColor=light-dark(#EDEFFB,#292D3F);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="816" y="184" width="264" height="112" as="geometry"/></mxCell>
        <mxCell id="src" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;spotter-sources&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Rust library]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Folder listing, bounded HTTP, downloads with resume and checksums.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#0B7A6E,#2CC4B0);fillColor=light-dark(#E7F2F1,#193333);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="816" y="336" width="264" height="112" as="geometry"/></mxCell>
        <mxCell id="rend" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;spotter-render&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[Rust library]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;A Chromium driver over the DevTools protocol, behind PageRenderer.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#0B7A6E,#2CC4B0);fillColor=light-dark(#E7F2F1,#193333);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="816" y="488" width="264" height="112" as="geometry"/></mxCell>
        <mxCell id="packs" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Packs&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[TOML]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Bundled presets and version schemes; more in the data folder.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#565E6B,#A0A7B2);fillColor=light-dark(#F0F2F5,#1B1E23);align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1200" y="184" width="264" height="112" as="geometry"/></mxCell>
        <mxCell id="hosts" value="&lt;span style=&quot;font-size:14px;font-weight:600&quot;&gt;Release hosts and shares&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:light-dark(#565E6B,#A0A7B2)&quot;&gt;[External systems]&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:4px;font-size:12px&quot;&gt;Folders, listings, APIs, forges, feeds, pages.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=-apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;fontSize=12;fontColor=light-dark(#14171C,#ECEEF1);rounded=1;absoluteArcSize=1;arcSize=6;strokeWidth=1.5;strokeColor=light-dark(#6B7380,#7F8794);fillColor=light-dark(#F4F5F7,#17191E);dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1200" y="336" width="264" height="112" as="geometry"/></mxCell>
