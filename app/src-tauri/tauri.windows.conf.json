{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spotter",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "create": false
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
